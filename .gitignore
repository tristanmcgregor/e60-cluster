# Allow-list: this folder also holds JLY firmware, dumps, logs and vendor binaries
# that must never be published. Only the paths re-included below are tracked.
/*
!/.gitignore
!/README.md

!/custom_dash/
/custom_dash/*
!/custom_dash/device/
!/custom_dash/tools/
!/custom_dash/preview/
/custom_dash/preview/fonts/
/custom_dash/preview/*.png

!/updater/

!/phone_updater/

!/cluster_video/
/cluster_video/*
!/cluster_video/src/
!/cluster_video/build/
!/cluster_video/test/
!/cluster_video/qmldir

!/wifi_driver/
/wifi_driver/*
!/wifi_driver/pkg/
/wifi_driver/pkg/*
!/wifi_driver/pkg/install/
/wifi_driver/pkg/install/*
!/wifi_driver/pkg/install/dashboard/
/wifi_driver/pkg/install/dashboard/*
!/wifi_driver/pkg/install/dashboard/etc/
/wifi_driver/pkg/install/dashboard/etc/*
!/wifi_driver/pkg/install/dashboard/etc/init.d/

.DS_Store
__pycache__/
