#!/bin/sh
# Over-the-air dash updates (see updater/PROTOCOL.md). Started by /etc/init.d/rcS at
# boot; everything runs in the background.
#
# While the head unit is reachable (S60wifi writes its address to /tmp/nav_gateway),
# this asks it once a minute for a newer dash bundle. A newer one is downloaded,
# checked against its sha256 and unpacked into /etc/dashv/<release>; then
# /etc/dash_active is pointed at it. /etc/d.qml reads that pointer when the
# Launcher starts. d.qml notices the new pointer and, once the car has been stopped for
# a few seconds, quits so the Launcher restarts on the new release; launcher_guard below
# brings it back if nothing else does (JLY's process.sh normally respawns it).
# Log: /tmp/dashupdate.log

ETC=${DASH_ETC:-/etc}                       # overridable for testing on a desktop
GATEWAY_FILE=${DASH_GATEWAY_FILE:-/tmp/nav_gateway}
TMP=${DASH_TMP:-/tmp}
PORT=8765
INTERVAL=20
EXPECT=$TMP/dash_restart_expected     # written at install; the guard only acts while it exists
LOG=$TMP/dashupdate.log
PIDFILE=$TMP/dashupdate.pid

log() { echo "$(date '+%H:%M:%S') $*" >> $LOG; }

# digits only, 0 when empty
num() { n=$(echo "$1" | tr -cd 0-9); echo ${n:-0}; }

# The release d.qml loads: the over-the-air pointer when it is newer than the USB install.
loaded_release() {
	a=$(num "$(cat $ETC/dash_active 2> /dev/null)")
	b=$(num "$(cat $ETC/dash/RELEASE 2> /dev/null)")
	if [ "$a" -gt "$b" ]; then echo $a; else echo $b; fi
}

check_once() {
	gw=$(cat $GATEWAY_FILE 2> /dev/null)
	[ -n "$gw" ] || return 0
	have=$(loaded_release)
	# usb: the release of the last USB install, so the head unit knows when the cluster needs a
	# newer USB package (it then copies one onto a stick plugged into it)
	usb=$(num "$(cat $ETC/dash/RELEASE 2> /dev/null)")
	rm -f $TMP/dashupd.txt
	wget -q -T 10 -O $TMP/dashupd.txt "http://$gw:$PORT/dash/manifest.txt?have=$have&usb=$usb" 2> /dev/null || return 0
	rel=$(num "$(sed -n 's/^release=//p' $TMP/dashupd.txt)")
	sha=$(sed -n 's/^sha256=//p' $TMP/dashupd.txt | tr -cd 0-9a-f)
	if [ "$rel" -eq 0 ] || [ ${#sha} -ne 64 ]; then
		log "unreadable manifest from $gw"
		return 0
	fi
	[ "$rel" -gt "$have" ] || return 0

	log "release $rel available (loaded $have), downloading"
	if ! wget -q -T 30 -O $TMP/dash.tgz "http://$gw:$PORT/dash/bundle.tar.gz" 2> /dev/null; then
		log "download failed"
		rm -f $TMP/dash.tgz
		return 0
	fi
	got=$(sha256sum $TMP/dash.tgz | cut -d' ' -f1)
	if [ "$got" != "$sha" ]; then
		log "checksum mismatch, discarded"
		rm -f $TMP/dash.tgz
		return 0
	fi

	new=$ETC/dashv/.new
	rm -rf $new
	mkdir -p $new
	if ! gunzip -c $TMP/dash.tgz | tar -x -C $new; then
		log "unpack failed"
		rm -rf $new $TMP/dash.tgz
		return 0
	fi
	rm -f $TMP/dash.tgz
	if [ ! -f $new/Dashboard.qml ] || [ "$(num "$(cat $new/RELEASE 2> /dev/null)")" != "$rel" ]; then
		log "bundle incomplete, discarded"
		rm -rf $new
		return 0
	fi

	# Switch with renames, so a power cut leaves either the old or the new pointer.
	rm -rf $ETC/dashv/$rel
	mv $new $ETC/dashv/$rel
	old=$(num "$(cat $ETC/dash_active 2> /dev/null)")
	if [ "$old" -ne 0 ] && [ "$old" -ne "$rel" ]; then
		echo $old > $ETC/dash_prev.tmp && mv $ETC/dash_prev.tmp $ETC/dash_prev
	fi
	echo $rel > $ETC/dash_active.tmp && mv $ETC/dash_active.tmp $ETC/dash_active
	sync

	# keep only the active and previous releases
	prev=$(num "$(cat $ETC/dash_prev 2> /dev/null)")
	for d in $ETC/dashv/*; do
		r=$(basename $d)
		[ "$r" = "$rel" ] || [ "$r" = "$prev" ] || rm -rf $d
	done
	sync
	date +%s > $EXPECT
	log "release $rel installed; the dash restarts onto it when the car is stopped"
}

# Remembers how the running Launcher was started (command line, environment, directory).
# After an install, if the dash quits to apply it and is not back within 8 s, starts it
# again the same way. Without a recent install it never starts anything, nor when JLY's
# process.sh (which runs alongside the Launcher) has gone too: JLY's own USB updater stops
# both on purpose.
supervisor() {
	for f in /proc/[0-9]*/cmdline; do
		case "$( { tr '\0' ' ' < $f; } 2> /dev/null)" in *process.sh*) echo 1; return ;; esac
	done
	echo 0
}
#
# Freeze watchdog: the map plugin rewrites a counter in $ALIVE every 2 s from the dash's main
# thread. If it stops changing for $FREEZE_CHECKS checks in a row (~30 s; counted in checks,
# not clock time, so the cluster sleeping is not a freeze) the dash is frozen: what it was
# doing goes to $FREEZE_LOG (kept across power-off), then it is killed and started again.
# A dash that vanishes while $ALIVE is still there crashed (a clean quit removes it): that is
# logged and it is started again too, unless process.sh went with it (JLY update).
# No $ALIVE (no map plugin loaded) means no watchdog. More than 3 freezes or crashes in
# 30 minutes and it stands down, so it can never keep the screen blank.
ALIVE=$TMP/dash_alive
FREEZE_LOG=${DASH_FREEZE_LOG:-$ETC/dashfreeze.log}
FREEZE_CHECKS=${DASH_FREEZE_CHECKS:-15}
# true when this is the 4th freeze/crash within 30 minutes
too_many() {
	t=$(cut -d. -f1 /proc/uptime)
	recent=; for f in $freezes; do [ $((t - f)) -lt 1800 ] && recent="$recent $f"; done
	freezes="$recent $t"
	[ $(echo $freezes | wc -w) -gt 3 ]
}
freeze_report() {
	{
		echo "=== $(date '+%Y-%m-%d %H:%M:%S') dash $2, pid $1, uptime $(cut -d' ' -f1 /proc/uptime)s"
		grep -E 'MemTotal|MemFree|MemAvailable|Cached' /proc/meminfo
		grep -E 'VmRSS|VmSize|Threads' /proc/$1/status
		echo "load $(cat /proc/loadavg)"
		for t in /proc/$1/task/*; do
			echo "  $(cat $t/comm 2> /dev/null) state=$(cut -d')' -f2 $t/stat 2> /dev/null | cut -d' ' -f2) wchan=$(cat $t/wchan 2> /dev/null)"
		done
		dmesg 2> /dev/null | tail -n 15
		echo "--- dashupdate.log"; tail -n 10 $LOG 2> /dev/null
	} >> $FREEZE_LOG 2>&1
	[ "$(wc -c < $FREEZE_LOG)" -gt 65536 ] && tail -c 32768 $FREEZE_LOG > $FREEZE_LOG.tmp && mv $FREEZE_LOG.tmp $FREEZE_LOG
	sync
}
launcher_guard() {
	missing=0
	beat=; still=0; freezes=
	while true; do
		pid=$(pidof Launcher 2> /dev/null | cut -d' ' -f1)
		if [ -n "$pid" ]; then
			missing=0
			now=$(cat $ALIVE 2> /dev/null)
			if [ "$pid" = "$guard_pid" ] && [ -n "$now" ] && [ "$now" = "$beat" ]; then
				still=$((still + 1))
			else
				still=0
			fi
			beat=$now
			if [ $still -ge $FREEZE_CHECKS ]; then
				still=0; beat=
				freeze_report $pid frozen
				if too_many; then
					log "dash frozen again (pid $pid); too many freezes, watchdog standing down"
					rm -f $ALIVE
				else
					log "dash frozen (pid $pid, heartbeat stopped), restarting it; details in $FREEZE_LOG"
					date +%s > $EXPECT          # the restart below brings it back if process.sh does not
					rm -f $ALIVE
					kill -9 $pid
				fi
				sleep 2
				continue
			fi
			if [ "$pid" != "$guard_pid" ] && [ -r /proc/$pid/cmdline ]; then
				rm -f $ALIVE; beat=; still=0      # a new dash: only its own heartbeat counts
				tr '\0' '\n' < /proc/$pid/cmdline > $TMP/launcher.cmd
				tr '\0' '\n' < /proc/$pid/environ > $TMP/launcher.env 2> /dev/null
				readlink /proc/$pid/cwd > $TMP/launcher.cwd 2> /dev/null
				had_supervisor=$(supervisor)
				[ -n "$guard_pid" ] && [ -f $EXPECT ] && { log "dash restarted (pid $pid)"; rm -f $EXPECT; }
				guard_pid=$pid
			fi
		elif [ ! -f $EXPECT ] && [ -f $ALIVE ] && [ -s $TMP/launcher.cmd ]; then
			rm -f $ALIVE
			freeze_report "$guard_pid" "died (crash?)"
			if too_many; then
				log "dash died again (pid $guard_pid); too many crashes, watchdog standing down"
			else
				log "dash died unexpectedly (pid $guard_pid); starting it again unless it comes back"
				date +%s > $EXPECT
			fi
			missing=0
		elif [ -f $EXPECT ] && [ -s $TMP/launcher.cmd ]; then
			missing=$((missing + 1))
			if [ $missing -ge 4 ]; then
				# an install older than 10 minutes is stale: the dash never quit for it
				if [ $(( $(date +%s) - $(cat $EXPECT) )) -gt 600 ]; then
					rm -f $EXPECT
				elif [ "$had_supervisor" = 1 ] && [ "$(supervisor)" = 0 ]; then
					log "Launcher and process.sh both stopped (JLY update?), not restarting"
					rm -f $EXPECT
				else
					log "dash not back after its restart, starting it"
					rm -f $EXPECT
					(
						cd "$(cat $TMP/launcher.cwd 2> /dev/null || echo /)"
						while IFS= read -r kv; do case "$kv" in *=*) export "$kv" ;; esac; done < $TMP/launcher.env
						set --
						while IFS= read -r a; do set -- "$@" "$a"; done < $TMP/launcher.cmd
						pidof Launcher > /dev/null 2>&1 && exit 0     # came back meanwhile
						exec "$@" >> $TMP/Launcher.log 2>&1
					) &
				fi
				missing=0
			fi
		fi
		sleep 2
	done
}

watch() {
	for tool in wget sha256sum gunzip tar; do
		command -v $tool > /dev/null || log "missing tool: $tool (updates disabled)"
	done
	launcher_guard &
	echo $! > $TMP/dashguard.pid
	sleep 20
	while true; do
		check_once
		[ "$(wc -c < $LOG 2> /dev/null || echo 0)" -gt 32768 ] && tail -c 16384 $LOG > $LOG.tmp && mv $LOG.tmp $LOG
		sleep $INTERVAL
	done
}

case "$1" in
	start|"")
		[ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2> /dev/null && exit 0
		log "start (loaded release $(loaded_release))"
		watch > /dev/null 2>&1 &
		echo $! > $PIDFILE
		;;
	stop)
		[ -f $PIDFILE ] && kill $(cat $PIDFILE) 2> /dev/null
		[ -f $TMP/dashguard.pid ] && kill $(cat $TMP/dashguard.pid) 2> /dev/null
		rm -f $PIDFILE $TMP/dashguard.pid
		log "stop"
		;;
	once)
		check_once
		;;
	guard)          # the restart guard alone, in the foreground (testing)
		launcher_guard
		;;
esac
exit 0
